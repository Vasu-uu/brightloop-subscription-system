DATABASE_URL="mysql://root:password@localhost:3306/brightloop"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
APP_URL="http://localhost:5173"
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
PORT=4000

# Email (optional). Without SMTP_HOST, emails are printed to the console instead.
SMTP_PORT=587
MAIL_FROM="Brightloop <no-reply@yourdomain.com>"

# Automatic billing (cron expression, server time). Default is 02:00 every day. Use "off" to disable.
BILLING_SCHEDULE="0 2 * * *"
